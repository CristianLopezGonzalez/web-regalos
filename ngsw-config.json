{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "fonts-icons",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/fonts/**", "/icons/**"]
      }
    },
    {
      "name": "stand-ins",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/stand-ins/**"]
      }
    }
  ]
}
